generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ExpenseStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED

  @@map("expense_status")
}

model Profile {
  id                     String    @id @db.Uuid
  displayName            String?   @map("display_name")
  creditCardOwnerName    String?   @map("credit_card_owner_name")
  financialCycleStartDay Int       @default(1) @map("financial_cycle_start_day") @db.SmallInt
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  incomes                Income[]
  expenses               Expense[]

  @@map("profiles")
}

model Income {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  description String
  amount      Decimal  @db.Decimal(14, 2)
  receivedOn  DateTime @map("received_on") @db.Date
  category    String
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, receivedOn(sort: Desc)])
  @@map("incomes")
}

model Expense {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String        @map("user_id") @db.Uuid
  description          String
  referenceAmount      Decimal       @map("reference_amount") @db.Decimal(14, 2)
  paidAmount           Decimal       @default(0) @map("paid_amount") @db.Decimal(14, 2)
  dueDate              DateTime      @map("due_date") @db.Date
  paidAt               DateTime?     @map("paid_at") @db.Date
  category             String
  status               ExpenseStatus @default(PENDING)
  notes                String?
  creditCardPurchaseId String?       @unique @map("credit_card_purchase_id") @db.Uuid
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                 Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueDate(sort: Desc)])
  @@index([userId, status, dueDate(sort: Desc)])
  @@map("expenses")
}

model CreditCard {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  bankName  String   @map("bank_name")
  name      String
  dueDay    Int?     @map("due_day") @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("credit_cards")
}

model CreditCardParticipant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("credit_card_participants")
}

model CreditCardPurchase {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  cardId       String   @map("card_id") @db.Uuid
  description  String
  amount       Decimal  @db.Decimal(14, 2)
  purchasedOn  DateTime @map("purchased_on") @db.Date
  invoiceMonth DateTime @map("invoice_month") @db.Date
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, cardId, invoiceMonth, purchasedOn(sort: Desc)])
  @@map("credit_card_purchases")
}

model CreditCardPurchaseSplit {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  purchaseId    String    @map("purchase_id") @db.Uuid
  participantId String?   @map("participant_id") @db.Uuid
  amount        Decimal   @db.Decimal(14, 2)
  paidAt        DateTime? @map("paid_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("credit_card_purchase_splits")
}
